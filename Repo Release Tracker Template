# ============================================================================
# Repo Release Monitor — TEMPLATE
#
# Posts a Discord notification whenever a new GitHub Release goes out on a
# repo of your choosing. See template-README.md for setup instructions.
# ============================================================================

name: Repo Release Monitor   # <-- CHANGE THIS to something unique, e.g. "MyProject Release Monitor"

on:
  schedule:
    - cron: "*/5 * * * *"
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: repo-release-monitor   # <-- CHANGE THIS if you add more than one monitor to the same repo
  cancel-in-progress: true

jobs:
  monitor:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    env:
      REPO: "OWNER/REPO"                    # <-- CHANGE THIS, e.g. "ChrisTitusTech/winutil"
      PROJECT_NAME: "Project Name"          # <-- CHANGE THIS, shown in the Discord message title, e.g. "winutil"
      STATE_FILE: "last_release.txt"        # <-- CHANGE THIS if you add more than one monitor to the same repo
      PING_MODE: "user"                     # one of: user, role, everyone, none - see template-README.md
      PING_ID: "YOUR_DISCORD_USER_ID_HERE"  # only needed when PING_MODE is "user" or "role" Leave default when PING_MODE is set to everyone/none

    steps:
      - name: Checkout monitor state
        uses: actions/checkout@v4

      - name: Check for new releases
        env:
          DISCORD_WEBHOOK: ${{ secrets.DISCORD_WEBHOOK }}
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          python3 <<'PY'
          import json
          import os
          import re
          import time
          import urllib.request
          import urllib.error
          from pathlib import Path

          REPO = os.environ["REPO"]
          PROJECT_NAME = os.environ["PROJECT_NAME"]
          API_URL = f"https://api.github.com/repos/{REPO}/releases?per_page=30"

          WEBHOOK = os.environ["DISCORD_WEBHOOK"]
          GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN", "")
          PING_MODE = os.environ.get("PING_MODE", "user").strip().lower()
          PING_ID = os.environ.get("PING_ID", "").strip()

          STATE = Path(os.environ["STATE_FILE"])
          # Discord's "components displayable text size" limit (4000) is a TOTAL
          # across every text component in one message, not per-component. Keep
          # every message's total text under this budget. The first message
          # carries the ping + header + as much of the notes as fits; anything
          # left over spills into continuation messages.
          TOTAL_MESSAGE_BUDGET = 3800
          CONTINUATION_LABEL_OVERHEAD = 80  # room for "(continued) - Part X/Y:" labels
          MIN_CHUNK = 200  # floor so an unusually long header never stalls chunking
          MAX_RELEASES_PER_RUN = 10  # cap so a bulk-import of releases can't flood the channel
          RETRY_ATTEMPTS = 3
          RETRY_BACKOFF_SECONDS = 3


          def fetch_with_retry(request_factory):
              """Run an HTTP request, retrying on transient network errors.
              HTTPError (4xx/5xx from the server) is NOT retried - those
              are real failures the caller should see immediately."""
              last_error = None
              for attempt in range(1, RETRY_ATTEMPTS + 1):
                  try:
                      req = request_factory()
                      with urllib.request.urlopen(req, timeout=30) as response:
                          return response.read()
                  except urllib.error.HTTPError:
                      raise
                  except (urllib.error.URLError, TimeoutError) as error:
                      last_error = error
                      print(f"Attempt {attempt}/{RETRY_ATTEMPTS} failed: {error}")
                      if attempt < RETRY_ATTEMPTS:
                          time.sleep(RETRY_BACKOFF_SECONDS * attempt)
              raise last_error


          def get_recent_releases():
              def build_request():
                  headers = {
                      "Accept": "application/vnd.github+json",
                      "User-Agent": "GitHub-Discord-Monitor/1.0",
                  }
                  if GITHUB_TOKEN:
                      headers["Authorization"] = f"Bearer {GITHUB_TOKEN}"
                  return urllib.request.Request(API_URL, headers=headers)

              body = fetch_with_retry(build_request)
              releases = json.loads(body)  # newest first
              # Mirror /releases/latest semantics: exclude drafts and prereleases.
              return [r for r in releases if not r.get("draft") and not r.get("prerelease")]


          def build_ping():
              """Returns (ping_text, allowed_mentions) for the configured PING_MODE."""
              if PING_MODE == "user" and PING_ID:
                  return f"<@{PING_ID}>", {"users": [PING_ID]}
              if PING_MODE == "role" and PING_ID:
                  return f"<@&{PING_ID}>", {"roles": [PING_ID]}
              if PING_MODE == "everyone":
                  return "@everyone", {"parse": ["everyone"]}
              return "", {}


          def send_discord(components, allowed_mentions=None):
              separator = "&" if "?" in WEBHOOK else "?"
              url = f"{WEBHOOK}{separator}wait=true&with_components=true"

              payload = {
                  "flags": 32768,  # IS_COMPONENTS_V2
                  "allowed_mentions": allowed_mentions or {},
                  "components": components,
              }
              body = json.dumps(payload).encode("utf-8")

              def build_request():
                  return urllib.request.Request(
                      url,
                      data=body,
                      headers={
                          "Content-Type": "application/json",
                          "User-Agent": "GitHub-Discord-Monitor/1.0",
                      },
                      method="POST",
                  )

              try:
                  fetch_with_retry(build_request)
              except urllib.error.HTTPError as error:
                  error_body = error.read().decode("utf-8", errors="replace")
                  print(f"Discord error HTTP {error.code}: {error_body}")
                  raise


          # GitHub auto-links bare "#123" issue/PR references AND full bare
          # issue/PR URLs on its own pages - but that's GitHub's renderer
          # doing the work at display time. The raw text from the API can
          # come either way depending on how the notes were written (some
          # projects mix both styles in one release: a hand-written section
          # using "#123", and an auto-generated section using the full URL).
          # Discord does neither kind of shortening/linking for bare "#123"
          # text, so normalize both forms into a real markdown link before
          # sending. Skips anything already inside a markdown link.
          ISSUE_REF_PATTERN = re.compile(r"(?<![\[\w/#])#(\d+)(?!\w)")
          ISSUE_URL_PATTERN = re.compile(
              r"(?<!\]\()(?<!\w)https://github\.com/"
              + re.escape(REPO)
              + r"/(?:pull|issues)/(\d+)(?=[\s).,]|$)"
          )


          def linkify_issue_refs(text):
              text = ISSUE_URL_PATTERN.sub(
                  lambda m: f"[#{m.group(1)}]({m.group(0)})", text
              )
              text = ISSUE_REF_PATTERN.sub(
                  lambda m: f"[#{m.group(1)}](https://github.com/{REPO}/issues/{m.group(1)})",
                  text,
              )
              return text


          def release_meta(release):
              tag = release.get("tag_name", "").strip()
              release_url = release.get("html_url")
              author = (release.get("author") or {}).get("login", "Unknown")
              notes = (release.get("body") or "").strip() or "(No release notes.)"
              notes = linkify_issue_refs(notes)
              return tag, release_url, author, notes


          def split_long_line(line, capacity):
              """Break a single line into pieces on whitespace only, each
              <= capacity. Never cuts a word or a link in half. Only used as a
              fallback for the rare line too long to fit in an empty chunk on
              its own (e.g. one giant unbroken paragraph)."""
              if len(line) <= capacity:
                  return [line]
              pieces = []
              remaining = line
              while len(remaining) > capacity:
                  cut = remaining.rfind(" ", 0, capacity + 1)
                  if cut <= 0:
                      cut = capacity
                  pieces.append(remaining[:cut].rstrip())
                  remaining = remaining[cut:].lstrip()
              if remaining:
                  pieces.append(remaining)
              return pieces


          def chunk_body(text, first_capacity, rest_capacity):
              """Pack text into message-sized chunks along LINE boundaries, so
              a bullet point (and any link inside it) always stays whole - a
              line that doesn't fit in what's left of the current message
              moves to the next one entirely, rather than being sliced."""
              atom_capacity = max(min(first_capacity, rest_capacity), MIN_CHUNK)
              atoms = []
              for line in text.split("\n"):
                  atoms.extend(split_long_line(line, atom_capacity))

              chunks = []
              current = []
              current_len = 0
              capacity = max(first_capacity, MIN_CHUNK)

              for atom in atoms:
                  added = len(atom) + (1 if current else 0)
                  if current and current_len + added > capacity:
                      chunks.append("\n".join(current))
                      current = []
                      current_len = 0
                      capacity = max(rest_capacity, MIN_CHUNK)
                      added = len(atom)
                  current.append(atom)
                  current_len += added

              if current:
                  chunks.append("\n".join(current))

              return chunks or [text]


          def send_release(release, ping, note=None):
              tag, release_url, author, notes = release_meta(release)

              title = f"## {PROJECT_NAME} Updated!"
              meta_lines = (
                  f"**Version:** {tag}\n"
                  f"**Author:** {author}\n"
                  f"**Release:** {release_url}"
              )
              meta_block = f"{note}\n\n{meta_lines}" if note else meta_lines

              ping_text, ping_mentions = build_ping() if ping else ("", {})

              first_overhead = len(ping_text) + len(title) + len(meta_block) + len("## Release Notes:\n")
              first_capacity = TOTAL_MESSAGE_BUDGET - first_overhead
              rest_capacity = TOTAL_MESSAGE_BUDGET - CONTINUATION_LABEL_OVERHEAD

              chunks = chunk_body(notes, first_capacity, rest_capacity)
              total = len(chunks)

              for index, chunk in enumerate(chunks, start=1):
                  components = []
                  mentions = {}
                  if index == 1:
                      if ping_text:
                          components.append({"type": 10, "content": ping_text})
                          mentions = ping_mentions
                      components.append({
                          "type": 17,
                          "components": [
                              {"type": 10, "content": title},
                              {"type": 14, "spacing": 1},
                              {"type": 10, "content": meta_block},
                              {"type": 14, "spacing": 2},
                              {"type": 10, "content": f"## Release Notes:\n{chunk}"},
                          ],
                      })
                  else:
                      heading = f"## Release Notes (continued) — Part {index}/{total}:"
                      components.append({
                          "type": 17,
                          "components": [{"type": 10, "content": f"{heading}\n{chunk}"}],
                      })
                  send_discord(components, mentions)


          def main():
              releases = get_recent_releases()
              if not releases:
                  print("No published releases found.")
                  return

              latest_tag = releases[0].get("tag_name", "").strip()
              old_tag = STATE.read_text().strip() if STATE.exists() else ""

              if latest_tag == old_tag:
                  print("No new release.")
                  return

              if not old_tag:
                  new_releases = [releases[0]]
                  gap = False
              else:
                  tag_index = {r.get("tag_name", "").strip(): i for i, r in enumerate(releases)}
                  if old_tag in tag_index:
                      new_releases = releases[:tag_index[old_tag]]
                      new_releases.reverse()
                      gap = False
                  else:
                      new_releases = [releases[0]]
                      gap = True

              overflow = 0
              if len(new_releases) > MAX_RELEASES_PER_RUN:
                  overflow = len(new_releases) - MAX_RELEASES_PER_RUN
                  new_releases = new_releases[-MAX_RELEASES_PER_RUN:]

              print(
                  f"New releases to report: {len(new_releases)}"
                  + (f", {overflow} more not shown individually" if overflow else "")
                  + (", gap detected (older release not found in history)" if gap else "")
              )

              note = None
              if gap:
                  note = "_Could not find the last-seen release in recent history - showing the latest release only._"
              elif overflow:
                  note = f"_{overflow} earlier release(s) in this batch were not posted individually._"

              for i, release in enumerate(new_releases):
                  send_release(release, ping=(i == 0), note=(note if i == 0 else None))

              STATE.write_text(latest_tag + "\n")
              print("Discord notification(s) sent and state saved.")


          if __name__ == "__main__":
              main()
          PY

      - name: Save monitor state
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add "$STATE_FILE"

          if git diff --cached --quiet; then
            echo "No state changes to commit."
          else
            git commit -m "Update $STATE_FILE ($(date -u +%Y-%m-%dT%H:%M:%SZ))"
            git pull --rebase origin "${GITHUB_REF_NAME}"
            git push
          fi
